<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><Version>0.3.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);MISIDE_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/LocalControlServer.cs" Link="LocalControlServer.cs" />
    <Compile Include="../Shared/Unity/*.cs" Link="Unity/%(Filename)%(Extension)" />
    <ProjectReference Include="../Miside.Camera.Core/Miside.Camera.Core.csproj" />
    <Reference Include="$(HostDirectory)/BepInEx/interop/*.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(HostDirectory)/BepInEx/core/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(HostDirectory)/BepInEx/core/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(HostDirectory)/BepInEx/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(HostDirectory)/BepInEx/core/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateHost" BeforeTargets="ResolveReferences">
    <Error Condition="'$(HostDirectory)' == '' Or !Exists('$(HostDirectory)/BepInEx/interop/Assembly-CSharp.dll')" Text="Pass HostDirectory for this game's generated IL2CPP interop. Never distribute game or interop DLLs." />
  </Target>
</Project>
