<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net6.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/LocalControlServer.cs" Link="LocalControlServer.cs" />
    <Reference Include="$(HostDirectory)/BepInEx/interop/*.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(HostDirectory)/BepInEx/core/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(HostDirectory)/BepInEx/core/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(HostDirectory)/BepInEx/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateHost" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(HostDirectory)/BepInEx/interop/Assembly-CSharp.dll')" Text="Pass HostDirectory for locally generated matching interop; do not distribute host DLLs." /></Target>
</Project>
